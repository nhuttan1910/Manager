# Sao chép file này thành .streamlit/secrets.toml (chạy local),
# hoặc dán nội dung vào mục Settings > Secrets trên Streamlit Cloud.

# Mật khẩu để mở app. Bỏ trống/xóa dòng này thì không cần đăng nhập.
APP_PASSWORD = "doi-mat-khau-nay"

# Chuỗi kết nối Supabase (Project Settings > Database > Connection string,
# chọn "Session pooler"). Bỏ dòng này thì app dùng SQLite trong data/expenses.db.
# DATABASE_URL = "postgresql://postgres.xxxxxxxx:MAT_KHAU@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
